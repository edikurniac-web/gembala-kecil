{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gembala-kecil-content",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "gembala-kecil-content"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:57182"
  }
}
