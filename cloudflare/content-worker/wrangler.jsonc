{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gembala-kecil-content",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "routes": [
    {
      "pattern": "api-gembalakecil.duniapinta.my.id",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "gembala-kecil-content"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:57182,https://gembalakecil.duniapinta.my.id,https://gembala-kecil.web.app,https://gembala-kecil.firebaseapp.com"
  }
}
