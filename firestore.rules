rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsParent(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validParent() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validChild() {
      return request.resource.data.keys().hasOnly([
          'name', 'avatarKey', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll([
          'name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['avatarKey'])
          || request.resource.data.avatarKey is string);
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
          'completed', 'lastPage', 'updatedAt'])
        && request.resource.data.keys().hasAll([
          'completed', 'lastPage', 'updatedAt'])
        && request.resource.data.completed is bool
        && request.resource.data.lastPage is int
        && request.resource.data.lastPage >= 0
        && request.resource.data.updatedAt is timestamp;
    }

    match /parents/{uid} {
      allow read: if ownsParent(uid);
      allow create: if ownsParent(uid) && validParent();
      allow update: if ownsParent(uid)
        && validParent()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /children/{childId} {
        allow read: if ownsParent(uid);
        allow create: if ownsParent(uid) && validChild();
        allow update: if ownsParent(uid)
          && validChild()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsParent(uid);

        match /progress/{storyId} {
          allow read: if ownsParent(uid);
          allow create, update: if ownsParent(uid) && validProgress();
          allow delete: if ownsParent(uid);
        }
      }

      // Purchase providers or trusted server code write entitlements.
      // A signed-in parent can only read their own current access.
      match /entitlements/{productId} {
        allow read: if ownsParent(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
